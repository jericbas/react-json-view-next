{
  "name": "react-json-view-next-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=packages/react-json-view-next",
    "test:coverage": "npm run test:coverage --workspace=packages/react-json-view-next",
    "test:perf": "npm run test --workspace=packages/react-json-view-next -- test/performance/benchmark.test.tsx",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "storybook": "npm run storybook --workspace=packages/storybook",
    "build:storybook": "npm run build-storybook --workspace=packages/storybook",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:lines": "node scripts/check-line-counts.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jericbas/react-json-view-next.git"
  },
  "author": "Jeric Bas",
  "license": "MIT"
}
